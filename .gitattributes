# Normalize line endings: LF in the repository, native in the working tree.
* text=auto eol=lf

# Explicit text types
*.cpp   text
*.hpp   text
*.h     text
*.cmake text
*.txt   text
*.json  text
*.md    text
*.vert  text
*.frag  text
*.glsl  text

# Binary assets — never munge
*.glb   binary
*.gltf  text
*.bin   binary
*.png   binary
*.jpg   binary
*.ttf   binary
*.otf   binary
*.kqr   binary
